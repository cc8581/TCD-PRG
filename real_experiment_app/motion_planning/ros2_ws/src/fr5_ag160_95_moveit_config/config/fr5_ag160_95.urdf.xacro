<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr5_ag160_95">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import fr5_ag160_95 urdf file -->
    <xacro:include filename="$(find fr5_ag160_95_description)/urdf/fr5_ag160_95.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="fr5_ag160_95.ros2_control.xacro" />


    <xacro:fr5_ag160_95_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
